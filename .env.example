# ── Database ──────────────────────────────────────────────
# Matches docker-compose.yml. Run `docker compose up -d db` first.
DATABASE_URL="postgresql://civicflow:civicflow@localhost:5432/civicflow?schema=public"

# ── App mode ──────────────────────────────────────────────
# demo:       demo officer logins + "Demo mode" labels (for trying it out)
# production: real officer accounts only (create them with: entrypoint.sh create-officer …)
CIVICFLOW_MODE="demo"

# Long random string. Signs citizen tracking tokens. Changing it invalidates existing tracking links.
# Generate with: openssl rand -base64 48
APP_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Public base URL used when building shareable tracking links.
APP_BASE_URL="http://localhost:3000"

# ── AI provider (live mode) ───────────────────────────────
# auto (default): use Claude when ANTHROPIC_API_KEY is set, otherwise the built-in rule-based classifier
# rules: never call an AI service, even if a key is set
AI_PROVIDER="auto"
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5-5"
# low | medium | high — triage is a focused extraction task
AI_EFFORT="low"
AI_TIMEOUT_MS="60000"

# ── Background processing ─────────────────────────────────
# Runs the durable job poller inside the Next.js server. Set to "false" if you run `npm run worker` separately.
RUN_INLINE_WORKER="true"
JOB_MAX_ATTEMPTS="3"

# ── Duplicate matching ────────────────────────────────────
MATCH_DISTANCE_METERS="150"
MATCH_STRONG_DISTANCE_METERS="60"
MATCH_WINDOW_DAYS="21"
RECURRENCE_WINDOW_DAYS="60"

# ── Citizen Google sign-in + Resend account verification ──
# Google OAuth Web application redirect URI: APP_BASE_URL + /api/citizen/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
RESEND_API_KEY=""
# A sender address on your Resend-verified domain, e.g. UrbanIQ <signin@example.com>
RESEND_FROM_EMAIL=""

# ── Storage ───────────────────────────────────────────────
# local: private directory outside /public. s3: any S3-compatible bucket (AWS, R2, MinIO).
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage/uploads"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ── Photo analysis (optional, advisory) ───────────────────
# Private CPU service in /vision running the AI Civic Guardian YOLO checkpoint.
# Leave VISION_URL empty to run without it: triage then uses text + location only.
# Use the PRIVATE network address (e.g. http://urbaniq-vision:8000 on Dokploy); never expose it publicly.
VISION_URL=""
# Shared secret; must equal VISION_TOKEN on the vision service. Generate with: openssl rand -hex 32
VISION_TOKEN=""
VISION_TIMEOUT_MS="20000"
# Detections below this confidence are shown to officers but never used to classify.
VISION_MIN_CONFIDENCE="0.5"

# ── Wards (server-side source of truth) ───────────────────
# Path to the municipality's ward GeoJSON (FeatureCollection; Polygon/MultiPolygon; properties.code + properties.name).
# Leave empty to use the clearly labelled SAMPLE wards of the fictional city of Port Alder.
WARDS_GEOJSON_PATH=""
# Without a ward file: "none"   = no ward boundaries — any pinned location in the service region is accepted (default)
#                      "sample" = fictional demo wards of Port Alder (offline demos only)
WARDS_MODE="none"
# Country served. "IN" = India only (pins, device location and Places search restricted to India). Empty = anywhere.
SERVICE_REGION="IN"
# Where the map opens before the officer's location is known ("lat,lng"). Defaults to all of India.
# e.g. "28.6139,77.2090" with MAP_DEFAULT_ZOOM="11" for New Delhi
MAP_DEFAULT_CENTER=""
MAP_DEFAULT_ZOOM=""
# Optional gazetteer for typed landmarks: [{ "name", "aliases": [], "lat", "lng", "wardCode" }]
LANDMARKS_JSON_PATH=""

# ── Google Maps (browser) ─────────────────────────────────
# Inlined into the browser bundle at BUILD time — set before `npm run build`.
# Restrict the key in Google Cloud Console:
#   • Application restriction: Websites (HTTP referrers) → https://YOUR-CIVICFLOW-DOMAIN/* (+ http://localhost:3000/* for dev)
#   • API restriction: Maps JavaScript API and Places API (New) only
# Leave empty to use the offline sample-city map; manual landmark entry always works.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Map ID (Google Cloud → Map Management, JavaScript, Vector). Required for Advanced Markers.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=""

# ── Offline map (used when no Google key) ─────────────────
# Optional raster tile template, e.g. https://tile.example.com/{z}/{x}/{y}.png
# Leave empty to use the built-in offline vector basemap of the fictional city.
NEXT_PUBLIC_MAP_TILE_URL=""
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=""
